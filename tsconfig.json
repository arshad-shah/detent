{
  "comment": "The shipped library. lib stays at ES2020 to match the build target, so source cannot silently use an API esbuild will not downlevel.",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": [],
    "rootDir": "src"
  },
  "include": [
    "src"
  ]
}
