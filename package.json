{
  "name": "detent-repo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:browser": "pnpm -r test:browser",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "typecheck": "pnpm -r typecheck",
    "size": "pnpm -r size",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm -r build && changeset publish",
    "docs": "pnpm -F docs dev",
    "docs:build": "pnpm -F docs build",
    "protect-main": "gh api -X PUT repos/arshad-shah/detent/branches/main/protection --input .github/branch-protection.json"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^3.0.2",
    "playwright": "^1.63.0"
  }
}
